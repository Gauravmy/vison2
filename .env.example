# Optional Gemini image analysis
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional weights and explicitly approved defect classes
PRODUCT_MODEL_PATH=models/product_detector.pt
PRODUCT_MODEL_VALIDATED=false
DEFECT_MODEL_PATH=models/defect_detector.pt
DEFECT_CLASS_NAMES=
DEFECT_MODEL_VALIDATED=false
AUTOMATED_PASS_ENABLED=false
MODEL_CONFIDENCE=0.35
PRODUCT_CATEGORY_CONFIDENCE=0.70

# Storage and local camera diagnostic
VISIONINSPECT_DATABASE=artifacts/inspections.sqlite3
VISIONINSPECT_IMAGE_DIR=artifacts/inspections
CAMERA_INDEX=0